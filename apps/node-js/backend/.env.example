# Backend Configuration

# Server
PORT=5000
NODE_ENV=development

# Failure Injection
FAILURE_INJECTION=false
FAILURE_SCENARIO=
FAILURE_DELAY_MS=0

# Logging
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://localhost:27017/moviebox

# JWT
JWT_SECRET=your-secret-key

# Session Cache
SESSION_CACHE_SIZE=100
